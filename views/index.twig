{# views/index.twig - الصفحة الرئيسية لثيم "The Memory Lane" #}
{# ================================================================ #}

{# 1. استدعاء الترويسة الأساسية للمتجر #}
{% include 'layouts/header.twig' %}

<main class="main-content" id="main-content">
    
    {# ========================================================= #}
    {# 2. قسم الترحيب العلوي - Hero Section مع خلفية تفاعلية #}
    {# ========================================================= #}
    <section class="hero-section section-padding" 
             style="background: linear-gradient(135deg, {{ theme.primary_color|default('#6C63FF') }} 0%, {{ theme.secondary_color|default('#FF6B6B') }} 100%);">
        <div class="container">
            <div class="hero-content text-center text-white">
                <h1 class="hero-title" style="font-size: 3.5rem; font-weight: 800; margin-bottom: 1rem;">
                    {{ settings.hero_title|default('اكتشف ذاكرتك القادمة') }}
                </h1>
                <p class="hero-subtitle" style="font-size: 1.25rem; opacity: 0.9; max-width: 600px; margin: 0 auto 2rem;">
                    {{ settings.hero_description|default('كل منتج يحمل قصة، اختر ما يناسب رحلتك') }}
                </p>
                
                {% if settings.hero_stories_enabled|default(true) %}
                <div class="hero-stories-preview">
                    <div class="hero-stories-avatars">
                        {% for i in 1..5 %}
                            <div class="hero-avatar-ring" style="display: inline-block; margin: 0 -8px; border: 3px solid rgba(255,255,255,0.3); border-radius: 50%;">
                                <img src="{{ asset('images/placeholder-avatar-' ~ i ~ '.jpg') }}" 
                                     alt="قصة {{ i }}" 
                                     style="width: 50px; height: 50px; border-radius: 50%; border: 3px solid white; display: block;"
                                     loading="lazy">
                            </div>
                        {% endfor %}
                    </div>
                    <p style="margin-top: 0.5rem; font-size: 0.9rem; opacity: 0.8;">
                        <i class="fas fa-play-circle"></i> 
                        {{ 'شاهد قصص عملائنا'|trans }}
                    </p>
                </div>
                {% endif %}
            </div>
        </div>
    </section>

    {# ========================================================= #}
    {# 3. مكون القصص التفاعلية (Stories Carousel) #}
    {# ========================================================= #}
    {% if settings.stories_enabled|default(true) %}
        {% component 'stories-carousel' %}
    {% endif %}

    {# ========================================================= #}
    {# 4. مكون عارض الذكريات (Memory Showcase) #}
    {# ========================================================= #}
    <section class="memory-showcase-section section-padding" 
             style="background: {{ settings.memory_section_bg|default('#f8f6f1') }};">
        <div class="container">
            <div class="showcase-header text-center">
                <h2 class="section-title" style="color: {{ theme.primary_color|default('#6C63FF') }};">
                    <i class="fas fa-crown" style="color: {{ theme.gold_color|default('#d4af37') }};"></i>
                    {{ settings.memory_showcase_title|default('ذاكرتنا المميزة') }}
                </h2>
                <p class="section-subtitle">{{ settings.memory_showcase_subtitle|default('اكتشف أجمل ما لدينا من منتجات تحمل ذكريات') }}</p>
            </div>
            
            {% component 'memory-showcase' %}
            
            {% if settings.show_view_all_btn|default(true) %}
            <div class="text-center" style="margin-top: 2rem;">
                <a href="{{ url('category') }}" class="btn btn-outline-gold" 
                   style="display: inline-block; padding: 0.75rem 2.5rem; border: 2px solid {{ theme.gold_color|default('#d4af37') }}; 
                          border-radius: 50px; color: {{ theme.gold_color|default('#d4af37') }}; font-weight: 600; 
                          transition: all 0.3s ease; text-decoration: none;">
                    <i class="fas fa-arrow-left"></i> 
                    {{ 'عرض جميع المنتجات'|trans }}
                </a>
            </div>
            {% endif %}
        </div>
    </section>

    {# ========================================================= #}
    {# 5. مكون الخط الزمني للذكريات (Memory Timeline) #}
    {# ========================================================= #}
    {% if settings.timeline_enabled|default(true) %}
        <section class="memory-timeline-section section-padding" 
                 style="background: var(--bg-primary);">
            <div class="container">
                <div class="timeline-header text-center">
                    <h2 class="section-title" style="color: {{ theme.primary_color|default('#6C63FF') }};">
                        <i class="fas fa-clock" style="color: {{ theme.gold_color|default('#d4af37') }};"></i>
                        {{ settings.timeline_title|default('رحلتنا عبر الزمن') }}
                    </h2>
                    <p class="section-subtitle">{{ settings.timeline_description|default('اكتشف كيف تطورت منتجاتنا مع مرور السنوات') }}</p>
                </div>
                
                {% component 'memory-timeline' %}
            </div>
        </section>
    {% endif %}

    {# ========================================================= #}
    {# 6. الفلترة العاطفية (Emotional Filter) #}
    {# ========================================================= #}
    {% if settings.emotional_filter_enabled|default(true) %}
        <section class="emotional-filter-section section-padding" 
                 style="background: {{ settings.filter_section_bg|default('#f8f6f1') }};">
            <div class="container">
                <div class="filter-header text-center">
                    <h2 class="section-title" style="color: {{ theme.primary_color|default('#6C63FF') }};">
                        <i class="fas fa-heart" style="color: {{ theme.gold_color|default('#d4af37') }};"></i>
                        {{ settings.filter_title|default('اختر هديتك حسب المناسبة') }}
                    </h2>
                    <p class="section-subtitle">{{ settings.filter_subtitle|default('دعنا نساعدك في اختيار المنتج المناسب') }}</p>
                </div>
                
                {% component 'emotional-filter' %}
            </div>
        </section>
    {% endif %}

    {# ========================================================= #}
    {# 7. عرض المنتجات المميزة (Featured Products) #}
    {# ========================================================= #}
    <section class="featured-products-section section-padding" 
             style="background: var(--bg-primary);">
        <div class="container">
            <div class="featured-header text-center">
                <h2 class="section-title" style="color: {{ theme.primary_color|default('#6C63FF') }};">
                    <i class="fas fa-star" style="color: {{ theme.gold_color|default('#d4af37') }};"></i>
                    {{ settings.featured_title|default('أكثر المنتجات طلباً') }}
                </h2>
                <p class="section-subtitle">{{ settings.featured_subtitle|default('اختارها عملاؤنا لتكون الأفضل') }}</p>
            </div>
            
            {% component 'featured-products' %}
        </div>
    </section>

    {# ========================================================= #}
    {# 8. قسم المميزات / الخدمات (Features/Service Cards) #}
    {# ========================================================= #}
    {% if settings.services_enabled|default(true) %}
        <section class="services-section section-padding" 
                 style="background: {{ settings.services_section_bg|default('#f8f6f1') }};">
            <div class="container">
                <div class="services-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem;">
                    
                    <div class="service-card" style="text-align: center; padding: 2rem; background: var(--bg-primary); 
                          border-radius: 16px; border: 1px solid var(--gold-light); transition: all 0.3s ease;">
                        <div class="service-icon" style="font-size: 3rem; color: {{ theme.gold_color|default('#d4af37') }}; margin-bottom: 1rem;">
                            <i class="fas fa-truck"></i>
                        </div>
                        <h3 style="font-weight: 700; margin-bottom: 0.5rem;">{{ 'توصيل سريع'|trans }}</h3>
                        <p style="color: var(--text-secondary); font-size: 0.9rem;">{{ 'شحن مجاني للطلبات فوق 200 ريال'|trans }}</p>
                    </div>
                    
                    <div class="service-card" style="text-align: center; padding: 2rem; background: var(--bg-primary); 
                          border-radius: 16px; border: 1px solid var(--gold-light); transition: all 0.3s ease;">
                        <div class="service-icon" style="font-size: 3rem; color: {{ theme.gold_color|default('#d4af37') }}; margin-bottom: 1rem;">
                            <i class="fas fa-gift"></i>
                        </div>
                        <h3 style="font-weight: 700; margin-bottom: 0.5rem;">{{ 'هدايا مجانية'|trans }}</h3>
                        <p style="color: var(--text-secondary); font-size: 0.9rem;">{{ 'مع كل طلب تحصل على هدية مميزة'|trans }}</p>
                    </div>
                    
                    <div class="service-card" style="text-align: center; padding: 2rem; background: var(--bg-primary); 
                          border-radius: 16px; border: 1px solid var(--gold-light); transition: all 0.3s ease;">
                        <div class="service-icon" style="font-size: 3rem; color: {{ theme.gold_color|default('#d4af37') }}; margin-bottom: 1rem;">
                            <i class="fas fa-undo-alt"></i>
                        </div>
                        <h3 style="font-weight: 700; margin-bottom: 0.5rem;">{{ 'إرجاع مجاني'|trans }}</h3>
                        <p style="color: var(--text-secondary); font-size: 0.9rem;">{{ 'استرجاع المنتج خلال 14 يوماً'|trans }}</p>
                    </div>
                    
                    <div class="service-card" style="text-align: center; padding: 2rem; background: var(--bg-primary); 
                          border-radius: 16px; border: 1px solid var(--gold-light); transition: all 0.3s ease;">
                        <div class="service-icon" style="font-size: 3rem; color: {{ theme.gold_color|default('#d4af37') }}; margin-bottom: 1rem;">
                            <i class="fas fa-headset"></i>
                        </div>
                        <h3 style="font-weight: 700; margin-bottom: 0.5rem;">{{ 'دعم 24/7'|trans }}</h3>
                        <p style="color: var(--text-secondary); font-size: 0.9rem;">{{ 'فريقنا يخدمك على مدار الساعة'|trans }}</p>
                    </div>
                    
                </div>
            </div>
        </section>
    {% endif %}

    {# ========================================================= #}
    {# 9. قسم التقييمات / شهادات العملاء (Testimonials) #}
    {# ========================================================= #}
    {% if settings.testimonials_enabled|default(true) %}
        <section class="testimonials-section section-padding" 
                 style="background: var(--bg-primary);">
            <div class="container">
                <div class="testimonials-header text-center">
                    <h2 class="section-title" style="color: {{ theme.primary_color|default('#6C63FF') }};">
                        <i class="fas fa-quote-right" style="color: {{ theme.gold_color|default('#d4af37') }};"></i>
                        {{ settings.testimonials_title|default('آراء عملائنا') }}
                    </h2>
                    <p class="section-subtitle">{{ settings.testimonials_subtitle|default('ما يقوله عملاؤنا عن تجربتهم معنا') }}</p>
                </div>
                
                <div class="testimonials-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
                    
                    {% for i in 1..3 %}
                        <div class="testimonial-card" style="background: var(--bg-secondary); padding: 2rem; border-radius: 16px; 
                              border: 1px solid var(--gold-light);">
                            <div class="testimonial-stars" style="color: {{ theme.gold_color|default('#d4af37') }}; margin-bottom: 1rem; font-size: 1.25rem;">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                            </div>
                            <p class="testimonial-text" style="color: var(--text-secondary); font-style: italic; margin-bottom: 1.5rem;">
                                "{{ settings.testimonial_text_i|default('تجربة رائعة، المنتجات عالية الجودة والتوصيل كان سريعاً. أنصح الجميع بالتسوق من هنا.') }}"
                            </p>
                            <div class="testimonial-author" style="display: flex; align-items: center; gap: 1rem;">
                                <div class="testimonial-avatar" style="width: 50px; height: 50px; border-radius: 50%; 
                                      background: {{ theme.gold_color|default('#d4af37') }}; display: flex; align-items: center; justify-content: center; 
                                      color: white; font-weight: 700; font-size: 1.25rem;">
                                    {{ settings.testimonial_author_initials_i|default('أ ح') }}
                                </div>
                                <div>
                                    <h4 style="font-weight: 700;">{{ settings.testimonial_author_i|default('أحمد الحسن') }}</h4>
                                    <p style="color: var(--text-light); font-size: 0.85rem;">{{ settings.testimonial_role_i|default('عميل مميز') }}</p>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    
                </div>
            </div>
        </section>
    {% endif %}

    {# ========================================================= #}
    {# 10. قسم النشرة البريدية (Newsletter) #}
    {# ========================================================= #}
    {% if settings.newsletter_enabled|default(true) %}
        <section class="newsletter-section section-padding" 
                 style="background: linear-gradient(135deg, {{ theme.primary_color|default('#6C63FF') }} 0%, {{ theme.secondary_color|default('#FF6B6B') }} 100%);">
            <div class="container">
                <div class="newsletter-content text-center" style="max-width: 600px; margin: 0 auto; color: white;">
                    <h2 style="font-size: 2rem; font-weight: 800; margin-bottom: 1rem;">
                        <i class="fas fa-envelope" style="margin-left: 0.5rem;"></i>
                        {{ settings.newsletter_title|default('اشترك في نشرتنا البريدية') }}
                    </h2>
                    <p style="opacity: 0.9; margin-bottom: 2rem;">
                        {{ settings.newsletter_description|default('احصل على أحدث العروض والمنتجات الحصرية أول بأول') }}
                    </p>
                    
                    <form class="newsletter-form" action="{{ url('newsletter.subscribe') }}" method="POST" 
                          style="display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center;">
                        <input type="email" name="email" placeholder="{{ 'أدخل بريدك الإلكتروني'|trans }}" 
                               style="flex: 1; min-width: 200px; padding: 0.75rem 1.5rem; border: none; border-radius: 50px; 
                                      font-size: 1rem; outline: none;" required>
                        <button type="submit" 
                                style="padding: 0.75rem 2rem; background: {{ theme.gold_color|default('#d4af37') }}; 
                                       color: white; border: none; border-radius: 50px; font-weight: 700; cursor: pointer; 
                                       transition: all 0.3s ease; white-space: nowrap;">
                            <i class="fas fa-paper-plane"></i>
                            {{ 'اشتراك'|trans }}
                        </button>
                    </form>
                    
                    <p style="font-size: 0.85rem; opacity: 0.7; margin-top: 1rem;">
                        <i class="fas fa-lock"></i>
                        {{ 'نحن نحمي بياناتك ولن نشاركها مع أي طرف ثالث'|trans }}
                    </p>
                </div>
            </div>
        </section>
    {% endif %}

</main>

{# ========================================================= #}
{# 11. استدعاء الذيل الأساسي للمتجر #}
{# ========================================================= #}
{% include 'layouts/footer.twig' %}

{# ========================================================= #}
{# 12. أزرار التفاعل السريع (Floating Action Buttons) #}
{# ========================================================= #}
{% if settings.quick_actions_enabled|default(true) %}
    <div class="quick-actions" style="position: fixed; bottom: 2rem; left: 2rem; z-index: 9997; display: flex; flex-direction: column; gap: 0.75rem;">
        
        {# زر العربة الذكية #}
        <button class="quick-action-btn cart-toggle" 
                onclick="document.querySelector('.cart-drawer')?.classList.toggle('open')"
                style="width: 60px; height: 60px; border-radius: 50%; background: {{ theme.primary_color|default('#6C63FF') }}; 
                       color: white; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.2); cursor: pointer; 
                       transition: all 0.3s ease; position: relative; font-size: 1.5rem; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-shopping-bag"></i>
            <span class="cart-badge" 
                  style="position: absolute; top: -5px; right: -5px; background: {{ theme.gold_color|default('#d4af37') }}; 
                         color: white; font-size: 0.65rem; width: 24px; height: 24px; border-radius: 50%; 
                         display: flex; align-items: center; justify-content: center; font-weight: 700;">
                0
            </span>
        </button>
        
        {# زر المساعدة / الدعم السريع #}
        <button class="quick-action-btn" 
                onclick="window.open('{{ settings.support_link|default('#') }}', '_blank')"
                style="width: 60px; height: 60px; border-radius: 50%; background: {{ theme.secondary_color|default('#FF6B6B') }}; 
                       color: white; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.2); cursor: pointer; 
                       transition: all 0.3s ease; font-size: 1.5rem; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-headset"></i>
        </button>
        
        {# زر العودة للأعلى #}
        <button class="quick-action-btn scroll-top" 
                onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
                style="width: 60px; height: 60px; border-radius: 50%; background: {{ theme.gold_color|default('#d4af37') }}; 
                       color: white; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.2); cursor: pointer; 
                       transition: all 0.3s ease; font-size: 1.5rem; display: flex; align-items: center; justify-content: center;
                       opacity: 0; transform: scale(0.8); pointer-events: none;">
            <i class="fas fa-arrow-up"></i>
        </button>
        
    </div>
    
    <style>
        .quick-action-btn:hover {
            transform: scale(1.1) !important;
        }
        
        .quick-action-btn:active {
            transform: scale(0.9) !important;
        }
        
        .scroll-top.visible {
            opacity: 1 !important;
            transform: scale(1) !important;
            pointer-events: auto !important;
        }
        
        @media (max-width: 768px) {
            .quick-actions {
                bottom: 1rem;
                left: 1rem;
            }
            .quick-action-btn {
                width: 50px !important;
                height: 50px !important;
                font-size: 1.25rem !important;
            }
        }
    </style>
    
    <script>
        // إظهار زر العودة للأعلى عند التمرير
        document.addEventListener('scroll', function() {
            const scrollBtn = document.querySelector('.scroll-top');
            if (window.scrollY > 300) {
                scrollBtn?.classList.add('visible');
            } else {
                scrollBtn?.classList.remove('visible');
            }
        });
        
        // تحديث عدد العربة (مثال - سيتم استبداله بمنطق سلة سلة الفعلي)
        document.addEventListener('DOMContentLoaded', function() {
            const cartBadge = document.querySelector('.cart-badge');
            if (cartBadge) {
                // يمكن جلب عدد المنتجات من سلة سلة باستخدام API
                // هذا مثال فقط
                fetch('{{ url('api/cart/count') }}')
                    .then(response => response.json())
                    .then(data => {
                        cartBadge.textContent = data.count || 0;
                    })
                    .catch(() => {
                        cartBadge.textContent = '0';
                    });
            }
        });
    </script>
{% endif %}

{# ========================================================= #}
{# 13. إعدادات تحسين محركات البحث (SEO) #}
{# ========================================================= #}
{% block seo %}
    <meta name="description" content="{{ settings.seo_description|default('ثيم السرد التفاعلي - اكتشف قصص المنتجات واختر ذاكرتك القادمة') }}">
    <meta name="keywords" content="{{ settings.seo_keywords|default('تسوق, هدايا, ذكريات, منتجات مميزة') }}">
    
    <!-- Open Graph -->
    <meta property="og:title" content="{{ settings.seo_og_title|default('The Memory Lane - اكتشف ذاكرتك القادمة') }}">
    <meta property="og:description" content="{{ settings.seo_og_description|default('متجر يروي قصصاً عبر منتجاته، اختر ما يناسب رحلتك') }}">
    <meta property="og:image" content="{{ settings.seo_og_image|default(asset('images/og-image.jpg')) }}">
    <meta property="og:type" content="website">
    
    <!-- Schema.org -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "{{ settings.store_name|default('The Memory Lane') }}",
        "url": "{{ url('home') }}",
        "description": "{{ settings.seo_description|default('ثيم السرد التفاعلي') }}"
    }
    </script>
{% endblock %}

{# ========================================================= #}
{# 14. الإعدادات المخصصة للصفحة الرئيسية #}
{# ========================================================= #}
<style>
    /* دعم خلفيات الأقسام المخصصة */
    .hero-section {
        position: relative;
        overflow: hidden;
        min-height: 60vh;
        display: flex;
        align-items: center;
    }
    
    .hero-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url('{{ settings.hero_background_image|default(asset('images/hero-bg.jpg')) }}') center/cover no-repeat;
        opacity: 0.1;
        z-index: 0;
    }
    
    .hero-content {
        position: relative;
        z-index: 1;
    }
    
    .hero-stories-avatars {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
    }
    
    .hero-avatar-ring {
        transition: transform 0.3s ease;
    }
    
    .hero-avatar-ring:hover {
        transform: translateY(-5px) scale(1.1);
    }
    
    .service-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-md);
        border-color: {{ theme.gold_color|default('#d4af37') }} !important;
    }
    
    .testimonial-card {
        transition: all 0.3s ease;
    }
    
    .testimonial-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-md);
        border-color: {{ theme.gold_color|default('#d4af37') }} !important;
    }
    
    .newsletter-form input:focus {
        box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.3);
    }
    
    .newsletter-form button:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }
</style>
