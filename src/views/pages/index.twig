{# src/views/pages/index.twig - الصفحة الرئيسية لثيم The Memory Lane #}
{# ==================================================================== #}

{% include 'layouts/header.twig' %}

<main class="main-content" id="main-content">
    
    {# ============================================================= #}
    {# 1. القسم العلوي (Hero Section) #}
    {# ============================================================= #}
    {% if settings.hero_enabled|default(true) %}
    <section class="hero-section section-padding" 
             style="background: linear-gradient(135deg, {{ settings.primary_color|default('#6C63FF') }} 0%, {{ settings.secondary_color|default('#FF6B6B') }} 100%);">
        <div class="container">
            <div class="hero-content text-center text-white">
                
                {# عنوان القسم العلوي #}
                <h1 class="hero-title" style="font-size: 3.5rem; font-weight: 800; margin-bottom: 1rem; line-height: 1.2;">
                    {{ settings.hero_title|default('اكتشف ذاكرتك القادمة') }}
                </h1>
                
                {# النص الفرعي #}
                <p class="hero-subtitle" style="font-size: 1.25rem; opacity: 0.9; max-width: 600px; margin: 0 auto 2rem; line-height: 1.8;">
                    {{ settings.hero_subtitle|default('كل منتج يحمل قصة، اختر ما يناسب رحلتك') }}
                </p>
                
                {# زر الدعوة #}
                {% if settings.hero_cta_text and settings.hero_cta_link %}
                <a href="{{ settings.hero_cta_link }}" 
                   class="hero-cta-btn" 
                   style="display: inline-block; padding: 0.75rem 2.5rem; background: {{ settings.gold_color|default('#d4af37') }}; 
                          color: white; border-radius: 50px; font-weight: 700; text-decoration: none; 
                          transition: all 0.3s ease; box-shadow: 0 4px 20px rgba(0,0,0,0.2);">
                    {{ settings.hero_cta_text|default('استكشف الآن') }}
                    <i class="fas fa-arrow-left" style="margin-right: 0.5rem;"></i>
                </a>
                {% endif %}
                
                {# معاينة قصص العملاء (أفاتار) #}
                {% if settings.hero_stories_enabled|default(true) %}
                <div class="hero-stories-preview" style="margin-top: 2rem;">
                    <div class="hero-stories-avatars" style="display: flex; justify-content: center; flex-wrap: wrap;">
                        {% for i in 1..5 %}
                            <div class="hero-avatar-ring" 
                                 style="margin: 0 -8px; border: 3px solid rgba(255,255,255,0.3); border-radius: 50%; 
                                        transition: transform 0.3s ease; cursor: pointer;">
                                <div style="width: 50px; height: 50px; border-radius: 50%; border: 3px solid white; 
                                            background: {{ settings.primary_color|default('#6C63FF') }}; 
                                            display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 1.2rem;">
                                    {{ ['أ', 'ن', 'س', 'م', 'ر']|random }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    <p style="margin-top: 0.75rem; font-size: 0.9rem; opacity: 0.8;">
                        <i class="fas fa-play-circle"></i> 
                        {{ 'شاهد قصص عملائنا'|trans }}
                    </p>
                </div>
                {% endif %}
                
            </div>
        </div>
    </section>
    {% endif %}

    {# ============================================================= #}
    {# 2. مكون القصص التفاعلية (Stories Carousel) #}
    {# ============================================================= #}
    {% if settings.stories_enabled|default(true) %}
        <section class="stories-section section-padding" 
                 style="background: {{ settings.bg_secondary|default('#f8f6f1') }};">
            <div class="container">
                {% component 'stories-carousel' %}
            </div>
        </section>
    {% endif %}

    {# ============================================================= #}
    {# 3. مكون عارض الذكريات (Memory Showcase) #}
    {# ============================================================= #}
    {% if settings.showcase_enabled|default(true) %}
        <section class="showcase-section section-padding" 
                 style="background: {{ settings.bg_color|default('#ffffff') }};">
            <div class="container">
                <div class="showcase-header text-center" style="margin-bottom: 3rem;">
                    <h2 class="section-title" style="color: {{ settings.text_color|default('#2d2d2d') }}; font-size: 2.5rem; font-weight: 800;">
                        <i class="fas fa-crown" style="color: {{ settings.gold_color|default('#d4af37') }}; margin-left: 0.5rem;"></i>
                        {{ settings.showcase_title|default('ذاكرتنا المميزة') }}
                    </h2>
                    <p class="section-subtitle" style="color: {{ settings.text_secondary|default('#666666') }}; font-size: 1.1rem; max-width: 600px; margin: 0.5rem auto 0;">
                        {{ settings.showcase_subtitle|default('اكتشف المنتجات التي تحمل قصصاً وذكريات') }}
                    </p>
                    <div style="width: 80px; height: 4px; background: {{ settings.gold_color|default('#d4af37') }}; margin: 1rem auto 0; border-radius: 2px;"></div>
                </div>
                
                {% component 'memory-showcase' %}
                
                {# زر عرض الكل #}
                {% if settings.showcase_show_view_all|default(true) %}
                <div class="text-center" style="margin-top: 3rem;">
                    <a href="{{ settings.showcase_view_all_link|default(url('category')) }}" 
                       class="btn-view-all" 
                       style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 2.5rem; 
                              border: 2px solid {{ settings.gold_color|default('#d4af37') }}; border-radius: 50px; 
                              color: {{ settings.gold_color|default('#d4af37') }}; background: transparent; 
                              font-weight: 600; transition: all 0.3s ease; text-decoration: none;">
                        <span>{{ settings.showcase_view_all_text|default('استكشف كل الذكريات') }}</span>
                        <i class="fas fa-arrow-left"></i>
                    </a>
                </div>
                {% endif %}
            </div>
        </section>
    {% endif %}

    {# ============================================================= #}
    {# 4. مكون الخط الزمني (Memory Timeline) #}
    {# ============================================================= #}
    {% if settings.timeline_enabled|default(true) %}
        <section class="timeline-section section-padding" 
                 style="background: {{ settings.bg_secondary|default('#f8f6f1') }};">
            <div class="container">
                <div class="timeline-header text-center" style="margin-bottom: 3rem;">
                    <h2 class="section-title" style="color: {{ settings.text_color|default('#2d2d2d') }}; font-size: 2.5rem; font-weight: 800;">
                        <i class="fas fa-clock" style="color: {{ settings.gold_color|default('#d4af37') }}; margin-left: 0.5rem;"></i>
                        {{ settings.timeline_title|default('رحلتنا عبر الزمن') }}
                    </h2>
                    <p class="section-subtitle" style="color: {{ settings.text_secondary|default('#666666') }}; font-size: 1.1rem; max-width: 600px; margin: 0.5rem auto 0;">
                        {{ settings.timeline_description|default('اكتشف كيف تطورت منتجاتنا مع مرور السنوات') }}
                    </p>
                </div>
                
                {% component 'memory-timeline' %}
            </div>
        </section>
    {% endif %}

    {# ============================================================= #}
    {# 5. مكون الفلترة العاطفية (Emotional Filter) #}
    {# ============================================================= #}
    {% if settings.emotional_filter_enabled|default(true) %}
        <section class="filter-section section-padding" 
                 style="background: {{ settings.bg_color|default('#ffffff') }};">
            <div class="container">
                <div class="filter-header text-center" style="margin-bottom: 3rem;">
                    <h2 class="section-title" style="color: {{ settings.text_color|default('#2d2d2d') }}; font-size: 2.5rem; font-weight: 800;">
                        <i class="fas fa-heart" style="color: {{ settings.gold_color|default('#d4af37') }}; margin-left: 0.5rem;"></i>
                        {{ settings.emotional_filter_title|default('لمن تبحث عن هدية اليوم؟') }}
                    </h2>
                    <p class="section-subtitle" style="color: {{ settings.text_secondary|default('#666666') }}; font-size: 1.1rem; max-width: 600px; margin: 0.5rem auto 0;">
                        {{ settings.emotional_filter_subtitle|default('دعنا نساعدك في اختيار المنتج المناسب') }}
                    </p>
                </div>
                
                {% component 'emotional-filter' %}
            </div>
        </section>
    {% endif %}

    {# ============================================================= #}
    {# 6. المنتجات المميزة (Featured Products) #}
    {# ============================================================= #}
    {% if settings.featured_products_enabled|default(true) %}
        <section class="featured-section section-padding" 
                 style="background: {{ settings.bg_secondary|default('#f8f6f1') }};">
            <div class="container">
                <div class="featured-header text-center" style="margin-bottom: 3rem;">
                    <h2 class="section-title" style="color: {{ settings.text_color|default('#2d2d2d') }}; font-size: 2.5rem; font-weight: 800;">
                        <i class="fas fa-star" style="color: {{ settings.gold_color|default('#d4af37') }}; margin-left: 0.5rem;"></i>
                        {{ settings.featured_products_title|default('أكثر المنتجات طلباً') }}
                    </h2>
                    <p class="section-subtitle" style="color: {{ settings.text_secondary|default('#666666') }}; font-size: 1.1rem; max-width: 600px; margin: 0.5rem auto 0;">
                        {{ settings.featured_products_subtitle|default('اختارها عملاؤنا لتكون الأفضل') }}
                    </p>
                </div>
                
                {% if feature('component-featured-products') %}
                    {% component 'featured-products' %}
                {% else %}
                    <div class="featured-placeholder" style="text-align: center; padding: 4rem 2rem; background: white; border-radius: 16px; border: 2px dashed {{ settings.gold_color|default('#d4af37') }};">
                        <i class="fas fa-box-open" style="font-size: 3rem; color: {{ settings.gold_color|default('#d4af37') }}; margin-bottom: 1rem; display: block;"></i>
                        <h3 style="font-weight: 700; margin-bottom: 0.5rem;">{{ 'لا توجد منتجات مميزة'|trans }}</h3>
                        <p style="color: {{ settings.text_secondary|default('#666666') }};">{{ 'يمكنك إضافة منتجات مميزة من لوحة التحكم'|trans }}</p>
                    </div>
                {% endif %}
            </div>
        </section>
    {% endif %}

    {# ============================================================= #}
    {# 7. قسم الخدمات (Services) #}
    {# ============================================================= #}
    {% if settings.services_enabled|default(true) %}
        <section class="services-section section-padding" 
                 style="background: {{ settings.bg_color|default('#ffffff') }};">
            <div class="container">
                <div class="services-header text-center" style="margin-bottom: 3rem;">
                    <h2 class="section-title" style="color: {{ settings.text_color|default('#2d2d2d') }}; font-size: 2.5rem; font-weight: 800;">
                        <i class="fas fa-gem" style="color: {{ settings.gold_color|default('#d4af37') }}; margin-left: 0.5rem;"></i>
                        {{ settings.services_title|default('ماذا نقدم لك؟') }}
                    </h2>
                </div>
                
                <div class="services-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem;">
                    
                    <div class="service-card" style="text-align: center; padding: 2rem; background: {{ settings.bg_secondary|default('#f8f6f1') }}; border-radius: 16px; border: 1px solid rgba(212, 175, 55, 0.2); transition: all 0.3s ease;">
                        <div class="service-icon" style="font-size: 3rem; color: {{ settings.gold_color|default('#d4af37') }}; margin-bottom: 1rem;">
                            <i class="fas fa-truck"></i>
                        </div>
                        <h3 style="font-weight: 700; margin-bottom: 0.5rem;">{{ 'توصيل سريع'|trans }}</h3>
                        <p style="color: {{ settings.text_secondary|default('#666666') }}; font-size: 0.9rem;">{{ 'شحن مجاني للطلبات فوق 200 ريال'|trans }}</p>
                    </div>
                    
                    <div class="service-card" style="text-align: center; padding: 2rem; background: {{ settings.bg_secondary|default('#f8f6f1') }}; border-radius: 16px; border: 1px solid rgba(212, 175, 55, 0.2); transition: all 0.3s ease;">
                        <div class="service-icon" style="font-size: 3rem; color: {{ settings.gold_color|default('#d4af37') }}; margin-bottom: 1rem;">
                            <i class="fas fa-gift"></i>
                        </div>
                        <h3 style="font-weight: 700; margin-bottom: 0.5rem;">{{ 'هدايا مجانية'|trans }}</h3>
                        <p style="color: {{ settings.text_secondary|default('#666666') }}; font-size: 0.9rem;">{{ 'مع كل طلب تحصل على هدية مميزة'|trans }}</p>
                    </div>
                    
                    <div class="service-card" style="text-align: center; padding: 2rem; background: {{ settings.bg_secondary|default('#f8f6f1') }}; border-radius: 16px; border: 1px solid rgba(212, 175, 55, 0.2); transition: all 0.3s ease;">
                        <div class="service-icon" style="font-size: 3rem; color: {{ settings.gold_color|default('#d4af37') }}; margin-bottom: 1rem;">
                            <i class="fas fa-undo-alt"></i>
                        </div>
                        <h3 style="font-weight: 700; margin-bottom: 0.5rem;">{{ 'إرجاع مجاني'|trans }}</h3>
                        <p style="color: {{ settings.text_secondary|default('#666666') }}; font-size: 0.9rem;">{{ 'استرجاع المنتج خلال 14 يوماً'|trans }}</p>
                    </div>
                    
                    <div class="service-card" style="text-align: center; padding: 2rem; background: {{ settings.bg_secondary|default('#f8f6f1') }}; border-radius: 16px; border: 1px solid rgba(212, 175, 55, 0.2); transition: all 0.3s ease;">
                        <div class="service-icon" style="font-size: 3rem; color: {{ settings.gold_color|default('#d4af37') }}; margin-bottom: 1rem;">
                            <i class="fas fa-headset"></i>
                        </div>
                        <h3 style="font-weight: 700; margin-bottom: 0.5rem;">{{ 'دعم 24/7'|trans }}</h3>
                        <p style="color: {{ settings.text_secondary|default('#666666') }}; font-size: 0.9rem;">{{ 'فريقنا يخدمك على مدار الساعة'|trans }}</p>
                    </div>
                    
                </div>
            </div>
        </section>
    {% endif %}

    {# ============================================================= #}
    {# 8. قسم التقييمات (Testimonials) #}
    {# ============================================================= #}
    {% if settings.testimonials_enabled|default(true) %}
        <section class="testimonials-section section-padding" 
                 style="background: {{ settings.bg_secondary|default('#f8f6f1') }};">
            <div class="container">
                <div class="testimonials-header text-center" style="margin-bottom: 3rem;">
                    <h2 class="section-title" style="color: {{ settings.text_color|default('#2d2d2d') }}; font-size: 2.5rem; font-weight: 800;">
                        <i class="fas fa-quote-right" style="color: {{ settings.gold_color|default('#d4af37') }}; margin-left: 0.5rem;"></i>
                        {{ settings.testimonials_title|default('آراء عملائنا') }}
                    </h2>
                    <p class="section-subtitle" style="color: {{ settings.text_secondary|default('#666666') }}; font-size: 1.1rem; max-width: 600px; margin: 0.5rem auto 0;">
                        {{ settings.testimonials_subtitle|default('ما يقوله عملاؤنا عن تجربتهم معنا') }}
                    </p>
                </div>
                
                <div class="testimonials-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
                    
                    {% for i in 1..3 %}
                        <div class="testimonial-card" style="background: {{ settings.bg_color|default('#ffffff') }}; padding: 2rem; border-radius: 16px; border: 1px solid rgba(212, 175, 55, 0.2); transition: all 0.3s ease;">
                            <div class="testimonial-stars" style="color: {{ settings.gold_color|default('#d4af37') }}; margin-bottom: 1rem; font-size: 1.25rem;">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                            </div>
                            <p class="testimonial-text" style="color: {{ settings.text_secondary|default('#666666') }}; font-style: italic; margin-bottom: 1.5rem; line-height: 1.8;">
                                "{{ ['تجربة رائعة، المنتجات عالية الجودة والتوصيل كان سريعاً.', 'أفضل متجر تعاملت معه، الخدمة ممتازة والمنتجات أصلية.', 'أنصح الجميع بالتسوق من هنا، تجربة لا تنسى.']|random }}"
                            </p>
                            <div class="testimonial-author" style="display: flex; align-items: center; gap: 1rem;">
                                <div class="testimonial-avatar" style="width: 50px; height: 50px; border-radius: 50%; background: {{ settings.gold_color|default('#d4af37') }}; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 1.25rem;">
                                    {{ ['أح', 'نو', 'سم', 'مص', 'رن']|random }}
                                </div>
                                <div>
                                    <h4 style="font-weight: 700;">{{ ['أحمد الحسن', 'نورة السعيد', 'سامي الغامدي', 'مصطفى علي', 'رنا الخالدي']|random }}</h4>
                                    <p style="color: {{ settings.text_light|default('#999999') }}; font-size: 0.85rem;">{{ ['عميل مميز', 'متسوق دائم', 'عميل موثوق']|random }}</p>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    
                </div>
            </div>
        </section>
    {% endif %}

    {# ============================================================= #}
    {# 9. قسم النشرة البريدية (Newsletter) #}
    {# ============================================================= #}
    {% if settings.newsletter_enabled|default(true) %}
        <section class="newsletter-section section-padding" 
                 style="background: linear-gradient(135deg, {{ settings.primary_color|default('#6C63FF') }} 0%, {{ settings.secondary_color|default('#FF6B6B') }} 100%);">
            <div class="container">
                <div class="newsletter-content text-center" style="max-width: 600px; margin: 0 auto; color: white;">
                    <h2 style="font-size: 2rem; font-weight: 800; margin-bottom: 1rem;">
                        <i class="fas fa-envelope" style="margin-left: 0.5rem;"></i>
                        {{ settings.newsletter_title|default('اشترك في نشرتنا البريدية') }}
                    </h2>
                    <p style="opacity: 0.9; margin-bottom: 2rem; font-size: 1.1rem;">
                        {{ settings.newsletter_description|default('احصل على أحدث العروض والمنتجات الحصرية أول بأول') }}
                    </p>
                    
                    <form class="newsletter-form" action="{{ url('newsletter.subscribe') }}" method="POST" 
                          style="display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center;">
                        <input type="email" name="email" placeholder="{{ 'أدخل بريدك الإلكتروني'|trans }}" 
                               style="flex: 1; min-width: 200px; padding: 0.75rem 1.5rem; border: none; border-radius: 50px; font-size: 1rem; outline: none;" 
                               required>
                        <button type="submit" 
                                style="padding: 0.75rem 2rem; background: {{ settings.gold_color|default('#d4af37') }}; color: white; border: none; border-radius: 50px; font-weight: 700; cursor: pointer; transition: all 0.3s ease; white-space: nowrap;">
                            <i class="fas fa-paper-plane"></i>
                            {{ 'اشتراك'|trans }}
                        </button>
                    </form>
                    
                    <p style="font-size: 0.85rem; opacity: 0.7; margin-top: 1rem;">
                        <i class="fas fa-lock"></i>
                        {{ 'نحن نحمي بياناتك ولن نشاركها مع أي طرف ثالث'|trans }}
                    </p>
                </div>
            </div>
        </section>
    {% endif %}

</main>

{# ============================================================= #}
{# 10. أزرار التفاعل السريع (Floating Action Buttons) #}
{# ============================================================= #}
{% if settings.quick_actions_enabled|default(true) %}
    <div class="quick-actions" 
         style="position: fixed; bottom: 2rem; {{ settings.quick_actions_position == 'bottom_left' ? 'left' : 'right' }}: 2rem; 
                z-index: 9997; display: flex; flex-direction: column; gap: 0.75rem;">
        
        {# زر العربة الذكية #}
        <button class="quick-action-btn cart-toggle" 
                onclick="document.querySelector('.cart-drawer')?.classList.toggle('open')"
                style="width: 60px; height: 60px; border-radius: 50%; background: {{ settings.primary_color|default('#6C63FF') }}; 
                       color: white; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.2); cursor: pointer; 
                       transition: all 0.3s ease; position: relative; font-size: 1.5rem; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-shopping-bag"></i>
            <span class="cart-badge" 
                  style="position: absolute; top: -5px; right: -5px; background: {{ settings.gold_color|default('#d4af37') }}; 
                         color: white; font-size: 0.65rem; width: 24px; height: 24px; border-radius: 50%; 
                         display: flex; align-items: center; justify-content: center; font-weight: 700;">
                0
            </span>
        </button>
        
        {# زر العودة للأعلى #}
        <button class="quick-action-btn scroll-top" 
                onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
                style="width: 60px; height: 60px; border-radius: 50%; background: {{ settings.gold_color|default('#d4af37') }}; 
                       color: white; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.2); cursor: pointer; 
                       transition: all 0.3s ease; font-size: 1.5rem; display: flex; align-items: center; justify-content: center;
                       opacity: 0; transform: scale(0.8); pointer-events: none;">
            <i class="fas fa-arrow-up"></i>
        </button>
        
    </div>
    
    <style>
        .quick-action-btn:hover {
            transform: scale(1.1) !important;
        }
        .quick-action-btn:active {
            transform: scale(0.9) !important;
        }
        .scroll-top.visible {
            opacity: 1 !important;
            transform: scale(1) !important;
            pointer-events: auto !important;
        }
        .service-card:hover {
            transform: translateY(-8px);
            border-color: {{ settings.gold_color|default('#d4af37') }} !important;
        }
        .testimonial-card:hover {
            transform: translateY(-5px);
            border-color: {{ settings.gold_color|default('#d4af37') }} !important;
        }
        .btn-view-all:hover {
            background: {{ settings.gold_color|default('#d4af37') }};
            color: white !important;
            transform: translateY(-3px);
        }
        @media (max-width: 768px) {
            .quick-actions {
                bottom: 1rem;
                {{ settings.quick_actions_position == 'bottom_left' ? 'left' : 'right' }}: 1rem;
            }
            .quick-action-btn {
                width: 50px !important;
                height: 50px !important;
                font-size: 1.25rem !important;
            }
        }
    </style>
    
    <script>
        // إظهار زر العودة للأعلى عند التمرير
        document.addEventListener('scroll', function() {
            const scrollBtn = document.querySelector('.scroll-top');
            if (window.scrollY > 300) {
                scrollBtn?.classList.add('visible');
            } else {
                scrollBtn?.classList.remove('visible');
            }
        });
    </script>
{% endif %}

{# ============================================================= #}
{# 11. التذييل #}
{# ============================================================= #}
{% include 'layouts/footer.twig' %}
