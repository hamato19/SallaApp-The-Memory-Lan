{
  "version": "1.0.0",
  "theme_name": "The Memory Lane",
  "theme_description": "ثيم السرد التفاعلي - يقدم تجربة تسوق فريدة تعتمد على القصص والتخصيص الفوري مع واجهة عصرية جذابة",
  "repo_url": "https://github.com/hamato19/SallaApp-The-Memory-Lan",
  "support_url": "https://github.com/hamato19/SallaApp-The-Memory-Lan",
  "author": "hamato19",
  "author_email": "hamato19@example.com",
  "settings": [
    {
      "id": "store_logo",
      "type": "image",
      "label": "شعار المتجر",
      "help": "يُفضل استخدام صورة PNG بخلفية شفافة"
    },
    {
      "id": "favicon",
      "type": "image",
      "label": "أيقونة المتجر (Favicon)",
      "help": "صورة مربعة بحجم 32x32 بكسل"
    },
    {
      "id": "primary_color",
      "type": "color",
      "label": "اللون الأساسي",
      "default": "#6C63FF"
    },
    {
      "id": "secondary_color",
      "type": "color",
      "label": "اللون الثانوي",
      "default": "#FF6B6B"
    },
    {
      "id": "gold_color",
      "type": "color",
      "label": "اللون الذهبي",
      "default": "#d4af37"
    },
    {
      "id": "bg_color",
      "type": "color",
      "label": "لون الخلفية الأساسي",
      "default": "#ffffff"
    },
    {
      "id": "text_color",
      "type": "color",
      "label": "لون النصوص الأساسي",
      "default": "#2d2d2d"
    },
    {
      "id": "hero_stories_enabled",
      "type": "toggle",
      "label": "تفعيل نظام القصص التفاعلية",
      "default": true
    },
    {
      "id": "stories_autoplay",
      "type": "select",
      "label": "تشغيل القصص تلقائياً",
      "default": "manual",
      "options": [
        { "value": "manual", "label": "يدوي" },
        { "value": "auto_3s", "label": "تلقائي كل 3 ثواني" },
        { "value": "auto_5s", "label": "تلقائي كل 5 ثواني" }
      ]
    },
    {
      "id": "configurator_enabled",
      "type": "toggle",
      "label": "تفعيل مصمم الباقات التفاعلي",
      "default": true
    },
    {
      "id": "emotional_filter_enabled",
      "type": "toggle",
      "label": "تفعيل الفلترة العاطفية",
      "default": true
    },
    {
      "id": "smart_cart_enabled",
      "type": "toggle",
      "label": "تفعيل العربة الذكية",
      "default": true
    },
    {
      "id": "checkout_modal_enabled",
      "type": "toggle",
      "label": "تفعيل الدفع السريع",
      "default": true
    },
    {
      "id": "animation_speed",
      "type": "select",
      "label": "سرعة الحركات التفاعلية",
      "default": "medium",
      "options": [
        { "value": "slow", "label": "بطيء" },
        { "value": "medium", "label": "متوسط" },
        { "value": "fast", "label": "سريع" }
      ]
    },
    {
      "id": "memory_theme",
      "type": "select",
      "label": "طابع الذكريات",
      "default": "vintage",
      "options": [
        { "value": "vintage", "label": "كلاسيكي قديم" },
        { "value": "modern", "label": "عصري حديث" },
        { "value": "minimal", "label": "بسيط وأنيق" },
        { "value": "vibrant", "label": "نابض بالحياة" }
      ]
    }
  ],
  "features": [
    "component-featured-products",
    "memory-stories",
    "product-configurator",
    "emotional-filter",
    "smart-cart",
    "quick-checkout"
  ],
  "components": [
    {
      "name": "memory-showcase",
      "title": "عارض الذكريات",
      "icon": "sicon-image-carousel",
      "path": "home.memory-showcase",
      "fields": [
        {
          "id": "showcase_title",
          "type": "text",
          "label": "عنوان العارض",
          "default": "رحلتك تبدأ من هنا"
        },
        {
          "id": "showcase_subtitle",
          "type": "text",
          "label": "النص الفرعي",
          "default": "اختر ذاكرتك القادمة"
        }
      ]
    },
    {
      "name": "stories-carousel",
      "title": "دوائر القصص التفاعلية",
      "icon": "sicon-instagram",
      "path": "home.stories-carousel",
      "fields": [
        {
          "id": "stories_title",
          "type": "text",
          "label": "عنوان القصص",
          "default": "اكتشف قصص منتجاتنا"
        }
      ]
    },
    {
      "name": "bundle-configurator",
      "title": "مصمم الباقات التفاعلي",
      "icon": "sicon-cube",
      "path": "product.bundle-configurator",
      "fields": [
        {
          "id": "configurator_title",
          "type": "text",
          "label": "عنوان المصمم",
          "default": "صمم باقاتك بنفسك"
        }
      ]
    },
    {
      "name": "emotional-filter",
      "title": "الفلترة العاطفية الذكية",
      "icon": "sicon-heart",
      "path": "category.emotional-filter",
      "fields": [
        {
          "id": "filter_title",
          "type": "text",
          "label": "عنوان الفلترة",
          "default": "لمن تبحث عن هدية اليوم؟"
        }
      ]
    },
    {
      "name": "smart-cart-drawer",
      "title": "عربة التسوق الذكية",
      "icon": "sicon-shopping-bag",
      "path": "cart.smart-cart-drawer",
      "fields": [
        {
          "id": "cart_title",
          "type": "text",
          "label": "عنوان العربة",
          "default": "سلة مشترياتك"
        }
      ]
    },
    {
      "name": "quick-checkout-modal",
      "title": "الدفع السريع بنافذة واحدة",
      "icon": "sicon-credit-card",
      "path": "checkout.quick-checkout-modal",
      "fields": [
        {
          "id": "modal_title",
          "type": "text",
          "label": "عنوان النافذة",
          "default": "إتمام الطلب بسرعة"
        }
      ]
    },
    {
      "name": "memory-timeline",
      "title": "خط زمني للذكريات",
      "icon": "sicon-calendar",
      "path": "home.memory-timeline",
      "fields": [
        {
          "id": "timeline_title",
          "type": "text",
          "label": "عنوان الخط الزمني",
          "default": "رحلتك معنا"
        }
      ]
    }
  ],
  "sections": {
    "home": [
      "home.stories-carousel",
      "home.memory-showcase",
      "home.memory-timeline"
    ],
    "product": [
      "product.bundle-configurator"
    ],
    "category": [
      "category.emotional-filter"
    ],
    "cart": [
      "cart.smart-cart-drawer"
    ],
    "checkout": [
      "checkout.quick-checkout-modal"
    ]
  }
}
